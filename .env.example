PORT=3000
# Configure only on the server. Never use a VITE_ prefix for secrets.
WU_API_KEY=
WU_STATION_ID=INOVAF30
# Fallback server-side: reads the public dashboard key when WU_API_KEY is empty.
WU_PUBLIC_FALLBACK=true
WU_PAGE_URL=https://www.wunderground.com/dashboard/pws/INOVAF30
# Public 11-character YouTube video ID (NOT the secret stream key).
YOUTUBE_VIDEO_ID=
# RTSP→HLS gateway base URL. Served to the browser via the same-origin /live
# proxy, so the camera works on HTTPS without mixed-content. Defaults to the
# project gateway when unset.
HLS_UPSTREAM=http://177.7.39.222:8888
# Optional: an explicit absolute browser-playable stream (HLS .m3u8 or MP4). If
# set, it takes precedence over the /live proxy. Never put RTSP credentials here.
CAMERA_STREAM_URL=
# Local visual preview only. Keep false in production.
ALLOW_DEMO=false
